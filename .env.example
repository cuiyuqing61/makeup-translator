# API key for the configured OpenAI-compatible model service.
DASHSCOPE_API_KEY=

# Independent OpenAI-compatible image editing endpoint. Default model favors precise edits.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2.5-sunburst

# OpenAI-compatible endpoint; AIHubMix uses https://aihubmix.com/v1.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=qwen-plus-latest
QWEN_AGENT_MODEL=qwen-plus
# Optional: use a separate text model for personalized tutorial planning/review.
# Product enrichment continues to use QWEN_AGENT_MODEL.
TUTORIAL_TEXT_MODEL=
TUTORIAL_MODEL_TIMEOUT_SECONDS=90
TUTORIAL_TEXT_MAX_TOKENS=4000
MAKEUP_GRAPH_PATH=runtime/tutorial-graph.sqlite3
# Optional override. Non-DashScope endpoints use native OpenAI-compatible
# tool_calls automatically. Set false for models requiring the text protocol.
QWEN_AGENT_USE_RAW_API=
# Limits one orchestration response; 3500 is enough for the tutorial schema and
# avoids long accidental reasoning output on third-party models.
QWEN_AGENT_MAX_TOKENS=3500
# GLM 5.3 defaults to deep reasoning; low is sufficient for bounded routing.
QWEN_REASONING_EFFORT=low
# Cache contains model observations, not image files. Delete to force a cold run.
MAKEUP_CACHE_PATH=runtime/agent-cache.sqlite3
# Product search: auto selects AIHubMix when QWEN_BASE_URL contains aihubmix.com.
# AIHubMix adds :surfing automatically; each search is billed separately.
SEARCH_PROVIDER=auto
SEARCH_MODEL=glm-5.3-flash
# AIHubMix :surfing may take longer than a normal model call.
PRODUCT_AGENT_TIMEOUT_SECONDS=70

# Legacy DashScope search settings, used only with SEARCH_PROVIDER=dashscope.
QWEN_SEARCH_MODEL=qwen-plus
QWEN_EXTRACTION_MODEL=qwen-turbo
DASHSCOPE_GENERATION_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
